<Page
    x:Class="NAITool.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:controls="using:NAITool.Mobile"
    utu:StatusBar.Foreground="Light"
    utu:StatusBar.Background="#1B2028"
    Background="#11151B"
    RequestedTheme="Dark"
    SizeChanged="OnPageSizeChanged">
    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B2028" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="NAI Utility" FontSize="19" FontWeight="SemiBold" Foreground="#F1F3F7" />
                    <TextBlock Text="mobile-dev" FontSize="12" Foreground="#9EAAC0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="API 设置" Click="OnSettingsClick" MinHeight="42" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,10,10,8">
            <Grid x:Name="WorkspaceGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="10*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ParametersPane" Grid.Column="0"
                        Background="#1B2028" BorderBrush="#363E4A" BorderThickness="1"
                        CornerRadius="12" Margin="0,0,6,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" Spacing="12">
                            <TextBlock Text="生成参数" FontSize="20" FontWeight="SemiBold" Foreground="#F1F3F7" />
                            <StackPanel x:Name="ConnectionPanel" Visibility="Collapsed" Spacing="5">
                                <TextBlock Text="连接设置" Foreground="#CCD5E4" FontWeight="SemiBold" />
                                <TextBlock Text="API 根地址（留空直连 NovelAI，支持兼容的 NyaProxy）"
                                           TextWrapping="Wrap" Foreground="#9EAAC0" FontSize="12" />
                                <TextBox x:Name="ApiRootBox" PlaceholderText="https://.../api/novelai" />
                                <TextBlock Text="API Key（仅保存在当前会话的内存中）" Foreground="#9EAAC0" FontSize="12" />
                                <PasswordBox x:Name="ApiTokenBox" />
                            </StackPanel>

                            <TextBlock Text="正面提示词" Foreground="#CCD5E4" FontWeight="SemiBold" />
                            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="114" PlaceholderText="输入 Prompt..." />
                            <TextBlock Text="负面提示词" Foreground="#CCD5E4" FontWeight="SemiBold" />
                            <TextBox x:Name="NegativePromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="74" PlaceholderText="Negative Prompt..." />
                            <TextBlock Text="风格词（可选）" Foreground="#CCD5E4" />
                            <TextBox x:Name="StylePromptBox" PlaceholderText="Style Prompt" />

                            <TextBlock Text="生成模型" Foreground="#CCD5E4" FontWeight="SemiBold" />
                            <ComboBox x:Name="ModelCombo" HorizontalAlignment="Stretch" SelectedIndex="0"
                                      SelectionChanged="OnModelChanged">
                                <ComboBoxItem Content="NovelAI Diffusion V5 Full" Tag="nai-diffusion-5-full" />
                                <ComboBoxItem Content="NovelAI Diffusion V5 Curated" Tag="nai-diffusion-5-curated" />
                                <ComboBoxItem Content="NovelAI Diffusion V4.5 Full" Tag="nai-diffusion-4-5-full" />
                                <ComboBoxItem Content="NovelAI Diffusion V4.5 Curated" Tag="nai-diffusion-4-5-curated" />
                                <ComboBoxItem Content="NovelAI Diffusion V4 Full" Tag="nai-diffusion-4-full" />
                                <ComboBoxItem Content="NovelAI Diffusion V4 Curated" Tag="nai-diffusion-4-curated-preview" />
                                <ComboBoxItem Content="NovelAI Diffusion V3" Tag="nai-diffusion-3" />
                                <ComboBoxItem Content="NovelAI Diffusion V3 Furry" Tag="nai-diffusion-furry-3" />
                            </ComboBox>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="尺寸" Foreground="#CCD5E4" />
                                    <ComboBox x:Name="SizeCombo" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnSizeChanged">
                                        <ComboBoxItem Content="832 × 1216" Tag="832x1216" />
                                        <ComboBoxItem Content="1216 × 832" Tag="1216x832" />
                                        <ComboBoxItem Content="1024 × 1024" Tag="1024x1024" />
                                        <ComboBoxItem Content="1344 × 768" Tag="1344x768" />
                                        <ComboBoxItem Content="768 × 1344" Tag="768x1344" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Effort" Foreground="#CCD5E4" />
                                    <ComboBox x:Name="EffortCombo" HorizontalAlignment="Stretch" SelectedIndex="0"
                                              SelectionChanged="OnEffortChanged">
                                        <ComboBoxItem Content="High" Tag="high" />
                                        <ComboBoxItem Content="Medium" Tag="medium" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="PaidAnlasHint" Text="付费基价参考：计算中" Foreground="#9EAAC0" FontSize="12" />
                            <TextBlock x:Name="EffortHint" Foreground="#9EAAC0" FontSize="12"
                                       Text="Medium：14 Steps / Euler，保留 High 模式草稿。" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Sampler" Foreground="#CCD5E4" />
                                    <ComboBox x:Name="SamplerCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                        <ComboBoxItem Content="Euler Ancestral" Tag="k_euler_ancestral" />
                                        <ComboBoxItem Content="Euler" Tag="k_euler" />
                                        <ComboBoxItem Content="DPM++ 2M" Tag="k_dpmpp_2m" />
                                        <ComboBoxItem Content="DPM++ SDE" Tag="k_dpmpp_sde" />
                                        <ComboBoxItem Content="DDIM v3" Tag="ddim_v3" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Scheduler" Foreground="#CCD5E4" />
                                    <ComboBox x:Name="ScheduleCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                        <ComboBoxItem Content="Karras" Tag="karras" />
                                        <ComboBoxItem Content="Native" Tag="native" />
                                        <ComboBoxItem Content="Exponential" Tag="exponential" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="StepsLabel" Text="Steps · 23" Foreground="#CCD5E4" />
                                <Slider x:Name="StepsSlider" Minimum="1" Maximum="50" Value="23"
                                        StepFrequency="1" ValueChanged="OnStepsChanged" />
                                <TextBlock x:Name="ScaleLabel" Text="CFG Scale · 3.0" Foreground="#CCD5E4" />
                                <Slider x:Name="ScaleSlider" Minimum="1" Maximum="10" Value="3"
                                        StepFrequency="0.5" ValueChanged="OnScaleChanged" />
                            </StackPanel>
                            <TextBlock Text="Seed（0 为随机）" Foreground="#CCD5E4" />
                            <TextBox x:Name="SeedBox" Text="0" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Quality" Foreground="#CCD5E4" />
                                    <ComboBox x:Name="QualityCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                        <ComboBoxItem Content="Standard" Tag="standard" />
                                        <ComboBoxItem Content="Light" Tag="light" />
                                        <ComboBoxItem Content="Off" Tag="none" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="UC Preset" Foreground="#CCD5E4" />
                                    <ComboBox x:Name="UcCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                                        <ComboBoxItem Content="Heavy" Tag="heavy" />
                                        <ComboBoxItem Content="Light" Tag="light" />
                                        <ComboBoxItem Content="None" Tag="none" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="角色提示词" Foreground="#CCD5E4" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="AddCharacterButton" Content="+ 添加角色" Click="OnAddCharacter" MinHeight="40"/>
                                <TextBlock x:Name="CharacterLimitText" Text="1 / 22 角色" Foreground="#9EAAC0"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="CharacterPromptBox" PlaceholderText="角色 1 · Prompt" />
                            <TextBox x:Name="CharacterNegativeBox" PlaceholderText="角色 1 · Negative" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="FirstCharacterCoords" Content="自定义位置" VerticalAlignment="Center"/>
                                <TextBox x:Name="FirstCharacterX" Text="0.5" Width="62" InputScope="Number"/>
                                <TextBox x:Name="FirstCharacterY" Text="0.5" Width="62" InputScope="Number"/>
                            </StackPanel>
                            <StackPanel x:Name="ExtraCharactersHost" Spacing="8"/>
                            <CheckBox x:Name="StreamBox" Content="流式预览（MsgPack）" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="PreviewPane" Grid.Column="1"
                        Background="#1B2028" BorderBrush="#363E4A" BorderThickness="1"
                        CornerRadius="12" Margin="6,0,0,0" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="预览" FontSize="20" FontWeight="SemiBold" Foreground="#F1F3F7" />
                        <Grid Grid.Row="1" Margin="0,12">
                            <TextBlock x:Name="PreviewPlaceholder"
                                       Text="生成结果显示在这里" Foreground="#8793A8"
                                       TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Image x:Name="ResultImage" Stretch="Uniform" Visibility="Collapsed"
                                   VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                        </Grid>
                        <StackPanel Grid.Row="2" Spacing="8">
                            <TextBlock x:Name="ResultInfo" Foreground="#9EAAC0"
                                       TextWrapping="Wrap" Text="输出保存在应用沙盒中，暂不接入系统相册。" />
                            <Button x:Name="UseResultAsInpaintButton" Content="发送到重绘" IsEnabled="False"
                                    MinHeight="42" HorizontalAlignment="Stretch" Click="OnUseResultAsInpaint"/>
                            <Button x:Name="ExportButton" Content="导出到文件…" IsEnabled="False"
                                    MinHeight="42" HorizontalAlignment="Stretch" Click="OnExportClick"/>
                            <Button x:Name="SaveButton" Content="保存到本地历史"
                                    MinHeight="42" HorizontalAlignment="Stretch"
                                    IsEnabled="False" Click="OnSaveClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="InpaintPane" Visibility="Collapsed" Background="#1B2028"
                    CornerRadius="12" BorderBrush="#363E4A" BorderThickness="1" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导入图片" Click="OnLoadInpaintImage" MinHeight="42" />
                        <Button Content="从结果导入" Click="OnUseResultAsInpaint" MinHeight="42" />
                    </StackPanel>
                    <Grid Grid.Row="1" Background="#121820" MinHeight="170">
                        <TextBlock x:Name="MaskPlaceholder" Text="请先导入图片，然后用手指绘制白色遮罩区域。双指缩放和平移。"
                                   TextWrapping="Wrap" Foreground="#9EAAC0" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"/>
                        <controls:MobileMaskCanvas x:Name="MaskEditor" Visibility="Collapsed"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock Text="重绘画笔（遮罩仅标记需重绘区域；输出使用 WebP）"
                                   Foreground="#9EAAC0" TextWrapping="Wrap" FontSize="12" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="EraserBox" Content="橡皮" Click="OnEraserChanged"
                                      VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="BrushSlider" Minimum="2" Maximum="64" Value="16"
                                    StepFrequency="2" ValueChanged="OnBrushChanged" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="撤销" Click="OnMaskUndo" MinHeight="40"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                <Button Content="重做" Click="OnMaskRedo" MinHeight="40"/>
                                <Button Content="清空" Click="OnMaskClear" MinHeight="40"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="重绘强度" Foreground="#9EAAC0" FontSize="12"/>
                                <Slider x:Name="InpaintStrengthSlider" Minimum="0" Maximum="1" Value="1" StepFrequency="0.05"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="重绘噪声" Foreground="#9EAAC0" FontSize="12"/>
                                <Slider x:Name="InpaintNoiseSlider" Minimum="0" Maximum="1" Value="0" StepFrequency="0.05"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="MaskStatus" Text="未加载重绘底图" Foreground="#9EAAC0"
                                   FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="HistoryPane" Visibility="Collapsed"
                    Background="#1B2028" CornerRadius="12"
                    BorderBrush="#363E4A" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="本地历史（点选记录查看）"
                               Foreground="#F1F3F7" FontSize="19" FontWeight="SemiBold" />
                    <ListView Grid.Row="1" x:Name="HistoryList" Margin="0,8,0,0"
                              SelectionChanged="OnHistorySelected" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#1B2028" Padding="10,8">
            <StackPanel Spacing="7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button x:Name="ParametersTab" Content="参数" MinHeight="42" Click="OnParametersTab" />
                    <Button x:Name="PreviewTab" Content="预览" MinHeight="42" Click="OnPreviewTab" />
                    <Button x:Name="InpaintTab" Content="重绘" MinHeight="42" Click="OnInpaintTab" />
                    <Button x:Name="HistoryTab" Content="历史" MinHeight="42" Click="OnHistoryTab" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GenerateButton" Grid.Column="0" Content="开始生成"
                            MinHeight="46" Click="OnGenerateClick" />
                    <Button x:Name="CancelButton" Grid.Column="1" Content="取消"
                            MinHeight="46" IsEnabled="False" Click="OnCancelClick" />
                </Grid>
                <TextBlock x:Name="StatusText" Text="移动端实验版 · 请先设置 API Key"
                           Foreground="#9EAAC0" TextWrapping="Wrap"
                           TextAlignment="Center" FontSize="12" MaxLines="2" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
